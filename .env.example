# ── API Keys ──────────────────────────────────────────────────────────────────
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub (optional — raises rate limits for release checks from 60 to 5000/hr)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin panel ────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_make_it_strong_min_16_chars
# Random string ≥32 chars — used for HMAC token signing
ADMIN_SECRET=change_this_to_a_long_random_string_minimum_32_chars

# ── Release monitor (cron) ────────────────────────────────────────────────────
# Discord webhook URL — https://discord.com/developers/applications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Secret to protect the /api/check-releases endpoint from public calls
# Set this to a random string and add it as Authorization: Bearer <secret>
CRON_SECRET=change_this_random_cron_secret

# ── Site ──────────────────────────────────────────────────────────────────────
SITE_URL=https://your-domain.vercel.app
